# Copy this file to ".env" and fill it in. Never commit ".env" to GitHub.

# "dev" while building, "production" on Render
APP_ENV=dev

# Supabase > Connect > Session pooler (port 5432)
DB_HOST=aws-0-xxxx.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.yourprojectref
DB_PASSWORD=your-database-password
DB_SSLMODE=require

# Long random text, used to sign login tokens (any 40+ random characters)
JWT_SECRET=change-this-to-a-long-random-string
JWT_TTL_HOURS=24

# Front-end addresses allowed to call this API (comma separated, no trailing slash)
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# OTP codes
OTP_TTL_SECONDS=60
OTP_RESEND_WAIT_SECONDS=30

# Email sending (Brevo). Leave the key empty in dev: the code is returned in the API response instead.
BREVO_API_KEY=
MAIL_FROM_EMAIL=your-verified-sender@example.com
MAIL_FROM_NAME=Pawfect
